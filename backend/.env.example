# Copiá este archivo como ".env" (en esta misma carpeta) y completá tus datos.

DB_NAME="panaderiacainzo"
DB_USER="root"
DB_PASSWORD="tu_contraseña_de_mysql"
DB_HOST="localhost"
DB_PORT=3306
DB_DIALECT="mysql"

# Clave para firmar las sesiones. Poné cualquier texto largo y secreto.
JWT_SECRET="cambiar-por-un-texto-largo-y-secreto"

# Solo para bases en la nube (Aiven): conexión segura
# DB_SSL=true
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Solo en el servidor publicado: dirección de la página (Netlify)
# FRONTEND_URL=https://panaderiacainzo.netlify.app
